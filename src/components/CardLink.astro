---
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'title'> {
	title: string;
	icon?: StarlightIcon;
}

const { title, icon, href, ...attributes } = Astro.props;
---

<article class:list={['card', 'sl-flex', { linked: href }]}>
	<p class="title sl-flex">
		{icon && <Icon name={icon} class="icon" size="1.333em" />}
		{
			href ? (
				<a href={href} {...attributes}>
					<span set:html={title} />
				</a>
			) : (
				<span set:html={title} />
			)
		}
		{href && <Icon name="right-arrow" size="1.333em" class="arrow rtl:flip" />}
	</p>
	<div class="body"><slot /></div>
</article>

<style>
	@layer starlight.components {
		.card {
			--sl-card-border: var(--sl-color-purple);
			--sl-card-bg: var(--sl-color-purple-low);
			border: 1px solid var(--sl-color-gray-5);
			background-color: var(--sl-color-black);
			padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);
			flex-direction: column;
			gap: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);
			position: relative;
		}
        .card.linked {
            background-color: #070a12 !important;
            transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
            transition-timing-function: cubic-bezier(.4, 0, .2, 1);
            transition-duration: .15s;
        }
		.card:nth-child(4n + 1) {
			--sl-card-border: var(--sl-color-orange);
			--sl-card-bg: var(--sl-color-orange-low);
		}
		.card:nth-child(4n + 3) {
			--sl-card-border: var(--sl-color-green);
			--sl-card-bg: var(--sl-color-green-low);
		}
		.card:nth-child(4n + 4) {
			--sl-card-border: var(--sl-color-red);
			--sl-card-bg: var(--sl-color-red-low);
		}
		.card:nth-child(4n + 5) {
			--sl-card-border: var(--sl-color-blue);
			--sl-card-bg: var(--sl-color-blue-low);
		}
		.title {
			font-weight: 600;
			font-size: var(--sl-text-h4);
			color: var(--sl-color-white);
			line-height: var(--sl-line-height-headings);
			gap: 1rem;
			align-items: center;
		}
		.card .icon {
			border: 1px solid var(--sl-card-border);
			background-color: var(--sl-card-bg);
			padding: 0.2em;
			border-radius: 0.25rem;
			flex-shrink: 0;
		}
		.card .body {
			margin: 0;
			font-size: clamp(var(--sl-text-sm), calc(0.5rem + 1vw), var(--sl-text-body));
		}

		.title a {
			color: inherit;
			text-decoration: none !important;
		}
		/* Rende cliccabile l'intera card */
		.title a::before {
			content: '';
			position: absolute;
			inset: 0;
		}
		/* Eventuali link nel corpo restano cliccabili sopra il link della card */
		.body :global(a) {
			position: relative;
			z-index: 1;
		}
		.card .arrow {
			margin-inline-start: auto;
			flex-shrink: 0;
			color: var(--sl-color-gray-3);
            transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
            transition-timing-function: cubic-bezier(.4, 0, .2, 1);
            transition-duration: .15s;
		}

		.card.linked:hover {
            background-color: var(--card) !important;
			border-color: var(--sl-color-gray-2);
		}
		.card.linked:hover .arrow {
			color: var(--sl-color-white);
		}
	}
</style>
